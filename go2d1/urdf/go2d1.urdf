<?xml version="1.0" encoding="UTF-8"?>
<!-- go2_d1: Isaac Sim–ready URDF (ROS 2 bridge via Action Graph)
     Notes:
       • No <gazebo> or Ignition plugins. Isaac Sim will ignore those anyway.
       • No <transmission> blocks. Isaac Sim’s Articulation Controller drives joints directly.
       • Use the ROS2 Articulation Controller node in the Action Graph to send position/velocity/effort arrays.
       • Foot friction should be set in Isaac Sim via Physics Materials on the USD after import. -->

<robot name="go2_d1">

  <!-- =========================
       BASE + SENSORS MOUNTS
       ========================= -->
  <link name="base">
    <inertial>
      <origin xyz="0.021112 0 -0.005366" rpy="0 0 0"/>
      <mass value="6.921"/>
      <inertia ixx="0.02448" ixy="0.00012166" ixz="0.0014849" iyy="0.098077" iyz="-3.12E-05" izz="0.107"/>
